# BillCraft is a fully static, browser-only application.
# There is no API key, backend, or server-side processing required.

# NEXT_PUBLIC_BASE_PATH: sub-path for GitHub Pages project sites.
# The GitHub Actions deploy workflow injects this automatically (e.g. /billcraft).
# Leave empty for local development on http://localhost:3000.
NEXT_PUBLIC_BASE_PATH=""

# NEXT_PUBLIC_SITE_URL: canonical URL of the deployed site (used for metadata).
# The deploy workflow injects the GitHub Pages URL automatically.
NEXT_PUBLIC_SITE_URL=""
